<mxfile host="app.diagrams.net"><diagram name="SmartPark AI Week 3 FYP"><mxGraphModel grid="1" page="1" pageWidth="1380" pageHeight="670"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SmartPark AI Week 3 data pipeline" style="text;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=42;fontStyle=1;fontColor=#172d42;" vertex="1" parent="1"><mxGeometry x="50" y="16" width="1280" height="60" as="geometry" /></mxCell><mxCell id="subtitle" value="FYP footage and detector pilot to Topic 4" style="text;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#425b70;" vertex="1" parent="1"><mxGeometry x="50" y="76" width="1280" height="40" as="geometry" /></mxCell><mxCell id="s0" value="&lt;b&gt;1  Source&lt;/b&gt;&lt;br&gt;&lt;br&gt;85 detector-pilot images&lt;br&gt;200 indexed camera replay frames" style="rounded=1;html=1;align=left;spacingLeft=20;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#126c65;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="50" y="138" width="380" height="140" as="geometry" /></mxCell><mxCell id="s1" value="&lt;b&gt;2  Ingest&lt;/b&gt;&lt;br&gt;&lt;br&gt;Load the private ZIP&lt;br&gt;Match stable image IDs and paths" style="rounded=1;html=1;align=left;spacingLeft=20;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#126c65;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="500" y="138" width="380" height="140" as="geometry" /></mxCell><mxCell id="s2" value="&lt;b&gt;3  Inspect&lt;/b&gt;&lt;br&gt;&lt;br&gt;Check source roles and dimensions&lt;br&gt;Compare native and preview geometry" style="rounded=1;html=1;align=left;spacingLeft=20;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#126c65;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="950" y="138" width="380" height="140" as="geometry" /></mxCell><mxCell id="s3" value="&lt;b&gt;4  Prepare&lt;/b&gt;&lt;br&gt;&lt;br&gt;Retain source JPEG geometry&lt;br&gt;Index labels, timing and provenance" style="rounded=1;html=1;align=left;spacingLeft=20;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#126c65;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="950" y="350" width="380" height="140" as="geometry" /></mxCell><mxCell id="s4" value="&lt;b&gt;5  Validate&lt;/b&gt;&lt;br&gt;&lt;br&gt;Verify RGB decoding and SHA-256&lt;br&gt;Repeat the ordered export" style="rounded=1;html=1;align=left;spacingLeft=20;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#126c65;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="500" y="350" width="380" height="140" as="geometry" /></mxCell><mxCell id="s5" value="&lt;b&gt;6  Record lineage&lt;/b&gt;&lt;br&gt;&lt;br&gt;Publish metadata and run manifests&lt;br&gt;Hand 285 verified records to Topic 4" style="rounded=1;html=1;align=left;spacingLeft=20;whiteSpace=wrap;fillColor=#dff1ee;strokeColor=#126c65;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="50" y="350" width="380" height="140" as="geometry" /></mxCell><mxCell id="e0" source="s0" target="s1" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=3;strokeColor=#126c65;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" source="s1" target="s2" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=3;strokeColor=#126c65;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" source="s2" target="s3" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=3;strokeColor=#126c65;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" source="s3" target="s4" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=3;strokeColor=#126c65;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" source="s4" target="s5" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=3;strokeColor=#126c65;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="failure" value="Missing image, duplicate identity or failed verification: stop and review the source." style="rounded=1;align=left;spacingLeft=20;fillColor=#e4eef5;strokeColor=none;fontSize=23;" vertex="1" parent="1"><mxGeometry x="50" y="542" width="1280" height="74" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>