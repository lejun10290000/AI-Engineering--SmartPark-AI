<mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="camera" target="privacy"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="privacy" target="vision"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="elayout" value="bay definitions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;dashed=1;" edge="1" parent="1" source="layout" target="state"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="evalhead" value="EVALUATION — TESTING SUPPORT, NOT AN EXTRA USER-FACING RUNTIME FEATURE" style="text;html=1;align=left;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="825" width="1780" height="35" as="geometry"/></mxCell>
<mxCell id="testinput" value="LABELLED TEST INPUTS&lt;br&gt;Held-out frames, annotated clips, repeatable scenarios" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="70" y="875" width="500" height="92" as="geometry"/></mxCell>
<mxCell id="measure" value="MEASURE ACTUAL RESULTS&lt;br&gt;Macro-F1, track association, latency, successful runs and RAI checks" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="700" y="875" width="500" height="92" as="geometry"/></mxCell>
<mxCell id="compare" value="COMPARE WITH TARGETS&lt;br&gt;FR / NFR / RAI thresholds and evaluation criteria" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1330" y="875" width="455" height="92" as="geometry"/></mxCell>
