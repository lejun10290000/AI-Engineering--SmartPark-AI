<mxfile host="app.diagrams.net" agent="AI Engineering Week 2" version="24.7.17"><diagram id="smartpark-week2" name="SmartPark AI Architecture"><mxGraphModel dx="1900" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1020"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="SMARTPARK AI — REQUIREMENTS-DRIVEN APPLICATION ARCHITECTURE" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fillColor=#EDE9FE;strokeColor=#6D28D9;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1820" height="90" as="geometry"/></mxCell>
<mxCell id="simple_head" value="V1 (SIMPLE) — USER QUERY → APPLICATION → AI CAPABILITY → RESPONSE" style="text;html=1;align=left;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="135" width="1780" height="35" as="geometry"/></mxCell>
<mxCell id="s_user" value="DRIVER / OPERATOR&lt;br&gt;Requests an available bay or views parking occupancy" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;strokeWidth=2;fillColor=#DBEAFE;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="75" y="190" width="330" height="88" as="geometry"/></mxCell>
<mxCell id="s_app" value="SMARTPARK APPLICATION&lt;br&gt;Receives the request and presents the result" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;strokeWidth=2;fillColor=#FCE7F3;strokeColor=#DB2777;" vertex="1" parent="1"><mxGeometry x="520" y="190" width="330" height="88" as="geometry"/></mxCell>
<mxCell id="s_ai" value="PARKING AI CAPABILITY&lt;br&gt;Analyses the parking scene and determines occupancy" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;strokeWidth=2;fillColor=#DBEAFE;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="965" y="190" width="330" height="88" as="geometry"/></mxCell>
<mxCell id="s_resp" value="RESPONSE&lt;br&gt;Occupancy result or available-bay guidance" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;strokeWidth=2;fillColor=#EDE9FE;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="1410" y="190" width="330" height="88" as="geometry"/></mxCell>
<mxCell id="se0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="s_user" target="s_app"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="se1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="s_app" target="s_ai"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="se2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="s_ai" target="s_resp"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="why" value="WHY ADD COMPONENTS? — camera input, defined bay layout, tracking across frames, vacant-only selection, uncertain-track handling and footage minimisation are needed by the requirements." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=16;fillColor=#FFF7ED;strokeColor=#D97706;" vertex="1" parent="1"><mxGeometry x="55" y="305" width="1780" height="52" as="geometry"/></mxCell>
<mxCell id="ext_head" value="V1 (REQUIREMENTS-DRIVEN) — COMPONENTS ADDED ONLY WHERE JUSTIFIED" style="text;html=1;align=left;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="385" width="1780" height="35" as="geometry"/></mxCell>
<mxCell id="user" value="USER&lt;br&gt;Driver / visitor&lt;br&gt;Parking operator" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;strokeWidth=2;fillColor=#DBEAFE;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="205" height="95" as="geometry"/></mxCell>
<mxCell id="app" value="SMARTPARK APP / UI&lt;br&gt;Request a vacant bay&lt;br&gt;View current occupancy" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;strokeWidth=2;fillColor=#FCE7F3;strokeColor=#DB2777;" vertex="1" parent="1"><mxGeometry x="330" y="480" width="240" height="95" as="geometry"/></mxCell>
<mxCell id="vision" value="VISION AI CAPABILITY&lt;br&gt;FR1: bay occupancy&lt;br&gt;FR2: vehicle tracking" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;strokeWidth=2;fillColor=#DBEAFE;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="635" y="480" width="275" height="95" as="geometry"/></mxCell>
<mxCell id="state" value="PARKING STATE &amp; GUIDANCE&lt;br&gt;FR3: update bay status&lt;br&gt;FR4–FR5: choose and guide" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;strokeWidth=2;fillColor=#EDE9FE;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="975" y="480" width="300" height="95" as="geometry"/></mxCell>
<mxCell id="guard" value="RESPONSIBLE CHECKS &amp; RESPONSE&lt;br&gt;RAI1–2: block unsafe / uncertain guidance&lt;br&gt;Show bay ID + location, direction or no bay" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;strokeWidth=2;fillColor=#FFEDD5;strokeColor=#D97706;" vertex="1" parent="1"><mxGeometry x="1340" y="480" width="455" height="95" as="geometry"/></mxCell>
<mxCell id="camera" value="CAMERA INPUT&lt;br&gt;Images / video frames from the miniature parking scene" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;strokeWidth=2;fillColor=#DCFCE7;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="70" y="700" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="privacy" value="PRIVACY BOUNDARY&lt;br&gt;Retain only required scene data; exclude incidental personal data" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;strokeWidth=2;fillColor=#FFEDD5;strokeColor=#D97706;" vertex="1" parent="1"><mxGeometry x="390" y="700" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="layout" value="DEFINED PARKING LAYOUT&lt;br&gt;Bay IDs, boundaries and positions for occupancy and guidance" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;strokeWidth=2;fillColor=#F1F5F9;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="980" y="700" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="user" target="app"><mxGeometry relative="1" as="geometry"/></mxCell>
